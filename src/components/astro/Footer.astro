---
import { getProfile, getShortName } from '../../lib/portfolio';
import { GitHubIcon, InstagramIcon, LinkedInIcon } from '../react/ui/BrandIcons';

const profile = getProfile();
const { github, linkedin, instagram } = profile.contact;
const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: `https://github.com/${github}`, Icon: GitHubIcon },
  { label: 'LinkedIn', href: `https://www.linkedin.com/in/${encodeURIComponent(linkedin)}/`, Icon: LinkedInIcon },
  { label: 'Instagram', href: `https://www.instagram.com/${instagram}/`, Icon: InstagramIcon },
];
---

<footer class="border-t border-line py-10">
  <div class="container-page flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-display text-xl text-fg">{getShortName(profile.name)}</p>
      <p class="mt-1 text-body-sm text-fg-muted">{profile.title} · {profile.location}</p>
    </div>
    <div class="flex flex-col gap-4 sm:items-end">
      <ul class="flex items-center gap-1">
        {links.map(({ label, href, Icon }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-11 w-11 items-center justify-center rounded-sm text-fg-muted transition-colors hover:bg-surface hover:text-fg"
              aria-label={`${label} (abre en una pestaña nueva)`}
            >
              <Icon className="h-5 w-5" />
            </a>
          </li>
        ))}
      </ul>
      <p class="font-mono text-caption text-fg-subtle">© {year} {profile.name}</p>
    </div>
  </div>
</footer>
