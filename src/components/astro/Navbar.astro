---
import { getProfile, getShortName } from '../../lib/portfolio';

const shortName = getShortName(getProfile().name);
const navLinks = [
  { href: '#about', label: 'Sobre mí' },
  { href: '#experience', label: 'Experiencia' },
  { href: '#skills', label: 'Stack' },
  { href: '#projects', label: 'Proyectos' },
  { href: '#education', label: 'Formación' },
];
const themeIcons = `
  <svg class="h-4 w-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646Z"/></svg>
  <svg class="hidden h-4 w-4 dark:block" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
`;
---

<header class="fixed inset-x-0 top-0 z-[100] border-b border-line bg-bg/95">
  <div class="container-page flex h-header items-center justify-between gap-6">
    <a href="#" class="font-display text-xl text-fg transition-colors hover:text-accent">{shortName}</a>

    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link rounded-sm px-3 py-2 text-body-sm text-fg-muted transition-colors hover:text-fg aria-[current=true]:text-fg aria-[current=true]:underline aria-[current=true]:decoration-accent aria-[current=true]:underline-offset-8"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class="flex h-11 w-11 items-center justify-center rounded-sm text-fg-muted transition-colors hover:bg-surface hover:text-fg"
        aria-label="Cambiar entre tema claro y oscuro"
        set:html={themeIcons}
      />
      <a href="#contact" class="btn-primary hidden px-4 sm:inline-flex">Contacto</a>
      <button
        type="button"
        id="mobile-menu-btn"
        class="flex h-11 w-11 items-center justify-center rounded-sm text-fg-muted transition-colors hover:bg-surface hover:text-fg lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Menú" class="hidden border-t border-line bg-bg lg:hidden">
    <ul class="container-page flex flex-col py-2">
      {[...navLinks, { href: '#contact', label: 'Contacto' }].map((link) => (
        <li>
          <a href={link.href} class="block border-b border-line py-3 text-body text-fg last:border-0">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // Storage blocked (private mode): the theme still applies for this visit.
      }
    });
  });

  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const setMenuOpen = (isOpen: boolean) => {
    menu?.classList.toggle('hidden', !isOpen);
    menuBtn?.setAttribute('aria-expanded', String(isOpen));
    menuBtn?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  };
  menuBtn?.addEventListener('click', () => setMenuOpen(menu?.classList.contains('hidden') ?? false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const observer = new IntersectionObserver(
    (entries) => {
      entries
        .filter((entry) => entry.isIntersecting)
        .forEach((entry) => {
          navLinks.forEach((link) => {
            link.setAttribute('aria-current', String(link.getAttribute('href') === `#${entry.target.id}`));
          });
        });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );
  document.querySelectorAll('section[id]').forEach((section) => observer.observe(section));
</script>
