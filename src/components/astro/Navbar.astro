---
const navLinks = [
  { href: '#about', label: 'Sobre mi' },
  { href: '#experience', label: 'Experiencia' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Proyectos' },
  { href: '#education', label: 'Educacion' },
  { href: '#contact', label: 'Contacto' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 glass-nav">
  <nav class="mx-auto max-w-container container-padding flex items-center justify-between h-16">
    <a href="#" class="font-heading font-bold text-xl gradient-text">
      AV
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-body-sm text-slate-600 dark:text-text-secondary hover:text-primary-light transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="p-2 rounded-lg text-slate-600 dark:text-text-secondary hover:text-primary-light hover:bg-slate-100 dark:hover:bg-surface transition-all duration-200"
        aria-label="Cambiar tema"
      >
        <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646Z"/>
        </svg>
        <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
      </button>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-slate-600 dark:text-text-secondary hover:text-primary-light hover:bg-slate-100 dark:hover:bg-surface transition-all duration-200"
        aria-label="Abrir menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden">
    <div class="glass-card mx-4 mb-4 p-4 rounded-2xl">
      <ul class="flex flex-col gap-2">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="block py-2 px-3 rounded-lg text-slate-600 dark:text-text-secondary hover:text-primary-light hover:bg-slate-100 dark:hover:bg-surface transition-all duration-200"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on link click
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Active section highlighting
  const sections = document.querySelectorAll('section[id]');
  const navAnchors = document.querySelectorAll('nav a[href^="#"]');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navAnchors.forEach(a => {
          a.classList.toggle('text-primary-light', a.getAttribute('href') === `#${entry.target.id}`);
          if (a.getAttribute('href') !== `#${entry.target.id}`) {
            a.classList.remove('text-primary-light');
            a.classList.add('text-slate-600');
            a.classList.add('dark:text-text-secondary');
          } else {
            a.classList.remove('text-slate-600');
            a.classList.remove('dark:text-text-secondary');
          }
        });
      }
    });
  }, { rootMargin: '-40% 0px -60% 0px' });

  sections.forEach(s => observer.observe(s));
</script>
