---
import '../styles/global.css';
import StarfieldBackground from '../components/react/StarfieldBackground';
import { getProfile, getSkills } from '../lib/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const profile = getProfile();
const skills = getSkills();

const {
  title = 'Andres Vera | Technical Lead & Full-Stack Developer',
  description = `Portafolio profesional de ${profile.name}. ${profile.title} con ${profile.yearsOfExperience}+ anos de experiencia en Paraguay.`,
} = Astro.props;

// JSON-LD Person: lo que buscadores e IA parsean para describir/recomendar al dev.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  description: profile.summary,
  url: Astro.site?.href,
  email: `mailto:${profile.contact.businessEmail}`,
  worksFor: { '@type': 'Organization', name: profile.company },
  address: { '@type': 'PostalAddress', addressLocality: profile.location, addressCountry: 'PY' },
  knowsAbout: [
    ...skills.languages,
    ...skills.backendFrameworks,
    ...skills.frontendFrameworks,
    ...skills.infrastructure,
    ...skills.cloud,
  ],
  sameAs: [
    `https://github.com/${profile.contact.github}`,
    `https://www.linkedin.com/in/${profile.contact.linkedin}`,
    `https://www.instagram.com/${profile.contact.instagram}`,
    `https://${profile.contact.website}`,
  ],
};
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Andres Valentin Vera Chavez" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- JSON-LD Person: para que buscadores/IA describan y recomienden al dev -->
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <link rel="canonical" href={Astro.site?.href} />

    <!-- Dark mode: default dark, only switch to light if user explicitly chose it -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          // First visit or explicit dark: force dark and persist
          document.documentElement.classList.add('dark');
          if (!saved) localStorage.setItem('theme', 'dark');
        }
      } catch (e) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-dvh pt-20">
    <!-- Scroll progress bar -->
    <div class="scroll-progress" id="scroll-progress"></div>

    <a href="#main-content" class="skip-to-content">
      Saltar al contenido principal
    </a>

    <!-- Starfield background: fixed, z-0, decorative -->
    <StarfieldBackground client:load />

    <slot />

    <script>
      const progress = document.getElementById('scroll-progress');
      const updateProgress = () => {
        if (!progress) return;
        const scrollY = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const percent = docHeight > 0 ? scrollY / docHeight : 0;
        progress.style.transform = `scaleX(${percent})`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
    </script>
  </body>
</html>
