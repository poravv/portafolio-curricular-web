---
import '../styles/global.css';
import { getProfile, getShortName, getSkills } from '../lib/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const profile = getProfile();
const skills = getSkills();

const {
  title = `${getShortName(profile.name)} | ${profile.title}`,
  description = `Portafolio profesional de ${profile.name}. ${profile.title} con ${profile.yearsOfExperience} años de experiencia en Paraguay.`,
} = Astro.props;

// JSON-LD Person: lo que buscadores e IA parsean para describir/recomendar al dev.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  description: profile.summary,
  url: Astro.site?.href,
  email: `mailto:${profile.contact.businessEmail}`,
  worksFor: { '@type': 'Organization', name: profile.company },
  address: { '@type': 'PostalAddress', addressLocality: profile.location, addressCountry: 'PY' },
  knowsAbout: [
    ...skills.languages,
    ...skills.backendFrameworks,
    ...skills.frontendFrameworks,
    ...skills.infrastructure,
    ...skills.cloud,
  ],
  sameAs: [
    `https://github.com/${profile.contact.github}`,
    `https://www.linkedin.com/in/${profile.contact.linkedin}`,
    `https://www.instagram.com/${profile.contact.instagram}`,
    `https://${profile.contact.website}`,
  ],
};
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- JSON-LD Person: para que buscadores/IA describan y recomienden al dev -->
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <link rel="canonical" href={Astro.site?.href} />

    <!-- Default dark; light only when the visitor chose it. Runs before paint to avoid a flash. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.classList.remove('dark');
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-dvh pt-header">
    <a href="#main-content" class="skip-to-content">Saltar al contenido principal</a>
    <slot />
  </body>
</html>
