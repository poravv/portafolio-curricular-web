---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Andres Vera" description="Pagina no encontrada.">
  <main id="main-content" class="min-h-screen flex items-center justify-center container-padding">
    <div class="text-center max-w-md">
      <p class="font-heading font-bold text-7xl gradient-text">404</p>
      <h1 class="mt-4 font-heading font-bold text-2xl">Esta pagina no existe</h1>
      <p class="mt-3 text-text-secondary">
        El enlace que seguiste no lleva a ningun lado. Volve al portafolio.
      </p>
      <a
        href="/"
        class="inline-block mt-8 rounded-full border border-border px-6 py-3 font-medium transition-colors hover:bg-surface"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</Layout>
