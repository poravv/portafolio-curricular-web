---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Página no encontrada" description="Página no encontrada.">
  <main id="main-content" class="container-page flex min-h-[70dvh] flex-col justify-center py-section-sm">
    <p class="font-mono text-label text-accent">404</p>
    <h1 class="mt-4 font-display text-h2 text-fg">Esta página no existe</h1>
    <p class="mt-3 max-w-md text-body text-fg-muted">El enlace que seguiste no lleva a ningún lado.</p>
    <a href="/" class="btn-secondary mt-8 self-start">Volver al inicio</a>
  </main>
</Layout>
