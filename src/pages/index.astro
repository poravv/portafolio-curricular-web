---
import Layout from '../layouts/Layout.astro';
import { getPortfolio } from '../lib/portfolio';
import Navbar from '../components/astro/Navbar.astro';
import Hero from '../components/react/Hero.tsx';
import About from '../components/react/About.tsx';
import Experience from '../components/react/Experience.tsx';
import Skills from '../components/react/Skills.tsx';
import Projects from '../components/react/Projects.tsx';
import Education from '../components/react/Education.tsx';
import Certifications from '../components/react/Certifications.tsx';
import Contact from '../components/react/Contact.tsx';
import Footer from '../components/astro/Footer.astro';

const portfolio = getPortfolio();
---

<Layout>
  <Navbar />
  <main id="main-content">
    {/* Only Contact needs JS (copy button, local clock); the rest renders to static HTML. */}
    <Hero profile={portfolio.profile} experience={portfolio.experience} certifications={portfolio.certifications} />
    <About profile={portfolio.profile} projects={portfolio.projects} />
    <Experience experience={portfolio.experience} projects={portfolio.projects} />
    <Skills skills={portfolio.skills} />
    <Projects projects={portfolio.projects} />
    <Education education={portfolio.education} />
    <Certifications certifications={portfolio.certifications} />
    <Contact client:visible profile={portfolio.profile} />
  </main>
  <Footer />
</Layout>
